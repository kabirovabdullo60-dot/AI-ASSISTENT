{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../.claude/hooks/branch_guard.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "dart-flutter@dart-flutter": true
  }
}
